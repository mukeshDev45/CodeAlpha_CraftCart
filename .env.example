# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Option 1: Local MongoDB (for local development)
# MONGO_URI=mongodb://127.0.0.1:27017/craftcart
# Option 2: MongoDB Atlas (for production / Render cloud deployment)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/craftcart?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Initial Admin Credentials (used during database seeding)
ADMIN_NAME=CraftCart Administrator
ADMIN_EMAIL=admin@craftcart.com
ADMIN_PASSWORD=YourSecurePassword123
ADMIN_PHONE=9876543210
